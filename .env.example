# ==============================================================================
# INTELLIGENT TAX ASSISTANT - Environment Variables Example
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Database Connection URL
# For local dev / tests: sqlite:///./tax_assistant.db
# For Docker / PostgreSQL: postgresql://tax_user:tax_secure_password_2026@localhost:5432/tax_assistant_db
DATABASE_URL=sqlite:///./tax_assistant.db

# Security & Cryptography Keys
# Generate JWT Secret: openssl rand -hex 32
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet AES Cryptography Key (Must be 32 base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=U29tZVNlY3JldEZlcm5ldEtleUZvckVuY3J5cHRpb24xMjM=

# Document Storage & Limits
STORAGE_DIR=./data/storage
MAX_FILE_SIZE_BYTES=10485760 # 10 MB

# AI / LLM Provider Configuration (Optional - runs in rule-based fallback if unset)
# Supported: gemini, openai, anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS Settings (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
